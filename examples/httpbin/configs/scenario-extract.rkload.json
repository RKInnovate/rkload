{
  "$schema": "https://raw.githubusercontent.com/RKInnovate/rkload/main/schemas/v2/config.schema.json",
  "version": 2,

  "scenarios": [
    {
      "name": "extract-and-inject",
      "vus": 2,
      "iterations": 5,
      "timeout": "15s",
      "steps": [
        {
          "name": "mint-token",
          "method": "GET",
          "url": "https://httpbin.org/response-headers?X-Token=chain-demo-42",
          "extract": [
            { "var": "token", "from": "json", "path": "X-Token" }
          ],
          "assert": [
            { "type": "status", "equals": 200 }
          ]
        },
        {
          "name": "use-token",
          "method": "GET",
          "url": "https://httpbin.org/anything",
          "headers": { "Authorization": "Bearer ${token}" },
          "assert": [
            { "type": "status", "equals": 200 },
            { "type": "body-contains", "value": "chain-demo-42" }
          ]
        }
      ]
    }
  ]
}
