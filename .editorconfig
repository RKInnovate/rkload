# EditorConfig — https://editorconfig.org
# Single source of truth for whitespace rules across editors.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Go: tabs are mandatory (gofmt rejects spaces).
[*.go]
indent_style = tab
indent_size = 4

# Makefile recipe lines must start with a literal tab.
[Makefile]
indent_style = tab

# Markdown allows trailing whitespace as a hard line break.
[*.{md,markdown}]
trim_trailing_whitespace = false
