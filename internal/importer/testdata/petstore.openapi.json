{
  "openapi": "3.0.3",
  "info": { "title": "Petstore", "version": "1.0" },
  "servers": [
    { "url": "https://petstore.example.com/v1" }
  ],
  "security": [
    { "bearerAuth": [] }
  ],
  "paths": {
    "/pets": {
      "get": {
        "operationId": "listPets",
        "tags": ["pets"]
      },
      "post": {
        "operationId": "createPet",
        "tags": ["pets"],
        "requestBody": {
          "content": {
            "application/json": {
              "example": { "name": "Fluffy", "tag": "cat" }
            }
          }
        }
      }
    },
    "/pets/{petId}": {
      "get": {
        "operationId": "getPet",
        "tags": ["pets"],
        "security": []
      }
    },
    "/admin/stats": {
      "get": {
        "operationId": "adminStats",
        "tags": ["admin"]
      }
    }
  }
}
