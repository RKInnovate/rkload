{
  "info": {
    "name": "Petstore",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://petstore.example.com/v1" }
  ],
  "item": [
    {
      "name": "List pets",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/pets",
          "host": ["{{baseUrl}}"],
          "path": ["pets"]
        }
      }
    },
    {
      "name": "Pets",
      "item": [
        {
          "name": "Create pet",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Trace", "value": "{{traceId}}", "disabled": true }
            ],
            "url": {
              "raw": "{{baseUrl}}/pets",
              "host": ["{{baseUrl}}"],
              "path": ["pets"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Rex\",\"tag\":\"dog\"}"
            }
          }
        },
        {
          "name": "Get pet",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/pets/1"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Stats",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/admin/stats"
          }
        }
      ]
    }
  ]
}
