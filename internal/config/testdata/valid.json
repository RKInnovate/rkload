{
  "$schema": "https://raw.githubusercontent.com/RKInnovate/rkload/main/schemas/v1/config.schema.json",
  "version": 1,

  "GET": [
    {
      "name": "root",
      "url": "https://api.example.com/",
      "c": 50,
      "requests": 200
    },
    {
      "url": "https://api.example.com/health"
    }
